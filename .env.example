AIGW_ENVIRONMENT=local
AIGW_HOST=0.0.0.0
AIGW_PORT=8000
AIGW_DEBUG=false
AIGW_PERSISTENCE_BACKEND=memory

AIGW_DB_DSN=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
AIGW_REDIS_URL=redis://localhost:6379/0

AIGW_KAFKA_ENABLED=false
AIGW_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

AIGW_AUTH_JWT_ENABLED=false
AIGW_AUTH_API_KEYS_ENABLED=true
AIGW_AUTH_API_KEY_PEPPER_REF=literal://local-dev-pepper-change-me

AIGW_PROVIDER_ENABLED=["echo"]
AIGW_PROVIDER_DEFAULT_MODEL=echo/echo-1

# Optional upstream / fictional provider credentials (secret references)
# AIGW_PROVIDER_OPENAI_API_KEY_REF=literal://provider-a-secret
# AIGW_PROVIDER_OPENAI_BASE_URL=http://127.0.0.1:18001/v1
# AIGW_PROVIDER_ANTHROPIC_API_KEY_REF=literal://provider-b-secret
# AIGW_PROVIDER_ANTHROPIC_BASE_URL=http://127.0.0.1:18002/v1

AIGW_OTEL_LOG_LEVEL=INFO
AIGW_OTEL_LOG_FORMAT=console
AIGW_OTEL_METRICS_ENABLED=true
AIGW_OTEL_TRACING_ENABLED=false
